# Shell scripts must keep LF endings even when checked out on Windows.
# A .sh file with CRLF fails on Linux with
#   /usr/bin/env: 'bash\r': No such file or directory
# which is exactly the kind of silent Colab failure this build guards against.
*.sh text eol=lf

# Same reasoning for anything else executed by a POSIX interpreter.
*.bash  text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# Never touch binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.zip  binary
*.ply  binary
*.pth  binary
*.npy  binary
*.npz  binary
*.bin  binary
