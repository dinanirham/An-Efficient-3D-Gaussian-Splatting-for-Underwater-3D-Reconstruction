%% Figure 0 — High-level schematic, in the style the source papers use for 3DGS
%% and SeaSplat: the optimisation loop only, with the efficiency mechanisms
%% shown as what they are — insertions into one cycle.
%%
%% M1, M2, M3 are the factorial mechanisms. D is a supplementary contrast
%% (cell A0D, stage S6) and is drawn dashed because it is not a fourth factor:
%% M1 disables densification, so D is provably inert in every M1 cell.

flowchart TB

IMG[/"Multi-view underwater images"/] --> INIT["Initialise primitives"]
INIT --> GS["`3D Gaussian primitives
*position · covariance · opacity · colour*`"]
GS --> RAS["Differentiable rasterisation"]

RAS --> J["`**J** — medium-free radiance
*the scene with the water removed*`"]
RAS --> Z["`**Z** — rendered depth`"]

J --> IFM
Z --> IFM

IFM["`**Image formation model**
Î = J · exp&lpar;−β_att·Z&rpar; + σ&lpar;B∞&rpar;·&lpar;1 − exp&lpar;−β_bs·Z&rpar;&rpar;
*9 scene-global medium scalars*`"]

IFM --> IHAT["`**Î** — composed underwater image`"]
IHAT --> LOSS{{"`Photometric loss
against the capture`"}}

LOSS -.->|"gradients"| GS
LOSS -.->|"gradients"| IFM
LOSS -.->|"‖∂L/∂means2D‖"| ADC["`Adaptive density control
*what to clone, split, prune*`"]
ADC -.-> GS

M1>"`**M1** initialization
dense correspondences
replace the sparse cloud`"] -.-> INIT
M2>"`**M2** simplification
cut the population
to a fixed budget`"] -.-> GS
M3>"`**M3** quantization
attributes become
codebook indices`"] -.-> GS
MD>"`**D** supplementary
detach alpha gradients
from the density signal`"] -.-> ADC

classDef base   fill:#EDF2F2,stroke:#94A9A8,stroke-width:1px,color:#10201F
classDef medium fill:#EFEAF6,stroke:#7A5CA8,stroke-width:2px,color:#10201F
classDef mech   fill:#E4F1ED,stroke:#1F7A66,stroke-width:1.5px,color:#10201F
classDef supp   fill:#E4F1ED,stroke:#1F7A66,stroke-width:1.5px,stroke-dasharray:5 3,color:#10201F
classDef gate   fill:#FFFFFF,stroke:#94A9A8,stroke-width:1px,color:#10201F

class IMG,INIT,GS,RAS,J,Z,IHAT,ADC base
class IFM medium
class M1,M2,M3 mech
class MD supp
class LOSS gate
