%% Figure 1 — Detailed methodology pipeline, portrait.
%%
%% Shape conventions (ANSI/ISO flowchart):
%%   ([  ])  terminal        — start / end
%%   [/  /]  data            — input or output
%%   [   ]   process         — an operation
%%   [[  ]]  predefined      — a named sub-procedure from a source method
%%   {   }   decision        — a branch
%%   [(  )]  stored data     — a persisted, hashed artifact
%%   (( ))   connector       — ON-PAGE CONNECTOR. Two circles with the same
%%                             letter are the same point in the flow; the reader
%%                             matches them by label. Used instead of a long
%%                             backward edge, which would cross the phase blocks.
%%
%% Colour encodes ORIGIN, not function. Badges M1/M2/M3/D/CD carry identity.
%%
%% NOTE on the schedule: the two training regimes are drawn as a BRANCH rather
%% than as nested blocks, because the gates overlap. Density control runs to
%% iteration 15 000 — i.e. 5 000 iterations INTO the physics-aware regime — so a
%% nested block would misstate it.

flowchart TB

subgraph PRE["① PREPROCESSING — offline, once per scene, frozen before training"]
  direction TB
  S([Start]) --> IN[/"`SeaThru-NeRF corpus
4 scenes · 88 images · COLMAP poses`"/]
  IN --> UND["`**CD** · Undistort OPENCV → PINHOLE`"]
  UND --> SPL["Hold out every 8th frame by index"]
  SPL --> DAT[/"75 training views · 13 held-out frames"/]
end

DAT --> Q1{"`M1
enabled?`"}

subgraph INI["② INITIALIZATION"]
  direction TB
  Q1 -->|"no · baseline"| SFM[/"COLMAP sparse cloud · ~26 000 points"/]
  Q1 -->|"yes · M1"| ROMA[["`**M1** · RoMa dense correspondence`"]]
  ROMA --> TRI["Triangulate"]
  TRI --> Q2{"`Well
conditioned?`"}
  Q2 -->|"`parallax &lt; 1°
or behind camera`"| REJ["`**CD** · Reject — 24% of triangulations`"]
  Q2 -->|"accept"| PLY[("Hashed dense cloud · 244k – 294k points")]
  SFM --> GAU["Initialise Gaussian primitives"]
  PLY --> GAU
end

GAU --> ENT(("A"))

subgraph TRN["③ TRAINING — 30 000 iterations"]
  direction TB

  ENT --> RAS["Rasterise → radiance J, depth Z, alpha"]

  RAS --> SWP["`**CD** · Cross-frame depth-range sweep
*at every event and every 2 500 it*`"]
  SWP --> QM{"`i &gt; 10 000?
**image formation model**`"}

  QM -->|"NO · geometry-only regime"| L1["`Loss vs the **RAW render**
*veiling haze must be paid for by geometry*`"]

  QM -->|"YES · physics-aware regime"| NRM["Normalise depth per frame by its own min / max"]
  NRM --> CMP["`**Image formation model**
Î = J·exp&lpar;−β_att·Z&rpar; + σ&lpar;B∞&rpar;·&lpar;1−exp&lpar;−β_bs·Z&rpar;&rpar;`"]
  CMP --> L2["`Loss vs the **COMPOSED image**`"]

  L1 --> BP["Backpropagate"]
  L2 --> BP2["`Backpropagate → geometry **and** 9 medium scalars`"]

  BP --> ACC{"`Densification signal
composition`"}
  BP2 --> ACC
  ACC -->|"baseline"| SIG["`accumulate image **+ alpha** gradients`"]
  ACC -->|"D"| SIGD["`**D** · accumulate image gradients only
*alpha detached · cell A0D*`"]

  SIG --> QD{"i &lt; 15 000?"}
  SIGD --> QD
  QD -->|"yes"| DC{"`Density
control`"}
  DC -->|"baseline"| ADC["Adaptive density control — clone · split · prune"]
  DC -->|"M1"| PRN["`**M1** · Prune only — *densification disabled*`"]

  QD -->|"no"| EV{"`Scheduled
event?`"}
  ADC --> EV
  PRN --> EV

  EV -->|"M2 · i = 15 000 / 20 000"| SMP[["`**M2** · Importance-weighted simplification
cut to 200 000 primitives`"]]
  SMP --> RWM["`**CD** · 200 medium-only steps, geometry frozen
*the interval in which β falls*`"]
  EV -->|"M3 · i ≥ 22 000"| QNT[["`**M3** · Quantization-aware training
3 codebooks · straight-through estimator`"]]
  EV -->|"none"| NXT

  RWM --> NXT{"i = 30 000?"}
  QNT --> NXT
end

NXT -->|"no · i ← i+1"| RET(("A"))
NXT -->|"yes"| OUT[/"Trained model + 9 medium scalars"/]

subgraph EVA["④ EVALUATION"]
  direction TB
  OUT --> FID["`Fidelity · held-out frames
PSNR · SSIM · LPIPS
*+ vanilla reference, same harness*`"]
  OUT --> EFF["`Efficiency
count · bytes · fps
peak memory`"]
  OUT --> DIA["`**CD** · Diagnostics
collapse · dispersion · geometry
Ĵ continuous vs codebook, seed 0`"]
  FID --> REC[("Per-run record · 45 fields, hashed provenance")]
  EFF --> REC
  DIA --> REC
  REC --> END([End])
end

classDef inherited fill:#EDF2F2,stroke:#94A9A8,stroke-width:1px,color:#10201F
classDef mech      fill:#E4F1ED,stroke:#1F7A66,stroke-width:1.5px,color:#10201F
classDef supp      fill:#E4F1ED,stroke:#1F7A66,stroke-width:1.5px,stroke-dasharray:5 3,color:#10201F
classDef ours      fill:#FBEFEC,stroke:#C8462E,stroke-width:1.5px,color:#10201F
classDef medium    fill:#EFEAF6,stroke:#7A5CA8,stroke-width:1.5px,color:#10201F
classDef gate      fill:#FFFFFF,stroke:#94A9A8,stroke-width:1px,color:#10201F
classDef term      fill:#10201F,stroke:#10201F,color:#FFFFFF
classDef conn      fill:#FFFFFF,stroke:#48605F,stroke-width:2px,color:#10201F

class S,END term
class IN,DAT,SFM,SPL,GAU,RAS,L1,L2,BP,BP2,SIG,ADC,FID,EFF,OUT,PLY,REC inherited
class ROMA,TRI,PRN,SMP,QNT mech
class SIGD supp
class UND,REJ,RWM,DIA,SWP ours
class NRM,CMP medium
class Q1,Q2,QM,ACC,QD,DC,EV,NXT gate
class ENT,RET conn

style PRE fill:#F4F7F7,stroke:#CFDBDA,color:#48605F
style INI fill:#F4F7F7,stroke:#CFDBDA,color:#48605F
style TRN fill:#F1F5F5,stroke:#CFDBDA,color:#48605F
style EVA fill:#F4F7F7,stroke:#CFDBDA,color:#48605F
